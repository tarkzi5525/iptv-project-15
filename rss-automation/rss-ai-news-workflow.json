    {
      "parameters": {
        "promptType": "define",
        "text": "=Rewrite and enhance this tech news article for maximum SEO performance and reader engagement:\n\nOriginal Title: {{ $json.title }}\nContent: {{ $json.content }}\nImproved Title: {{ $json.improvedTitle }}\nMeta Description: {{ $json.approved_description }}\nTarget Keywords: {{ $json.Keywords_Research }}\nCompetitor Analysis: {{ $json.competitor_analysis }}\n\nRequirements:\n1. Write a comprehensive, engaging article (800-1200 words)\n2. Use the improved title\n3. Naturally integrate target keywords\n4. Add relevant subheadings (H2, H3)\n5. Include a compelling introduction and conclusion\n6. Format in Markdown\n7. Make it unique, informative, and valuable to readers",
        "options": {
          "systemMessage": "You are an expert tech journalist and SEO content writer. Create high-quality, engaging articles that rank well in search engines and provide genuine value to readers. Always write in a clear, professional tone with accurate information."
        }
      },
