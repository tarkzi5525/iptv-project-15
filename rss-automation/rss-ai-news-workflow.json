      "name": "competitor_analysis output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 700]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Research and identify the best keywords for this article:\n\nTitle: {{ $json.title }}\nContent: {{ $json.content.substring(0, 1000) }}\n\nProvide:\n1. Primary keyword (most important)\n2. 5-10 secondary keywords\n3. Long-tail keywords (3-5)\n4. Search intent classification\n5. Estimated search volume (low/medium/high)\n\nFocus on tech and AI-related keywords that are currently trending.",
        "options": {
          "systemMessage": "You are an SEO keyword research expert specializing in technology and AI topics. Use your knowledge to identify high-value, relevant keywords."
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000040",
      "name": "Keyword Strategy",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [600, 700]
