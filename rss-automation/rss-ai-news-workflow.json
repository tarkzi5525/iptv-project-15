      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Get HTML Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 740]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "h1",
              "returnValue": "text"
            },
            {
              "key": "content",
              "cssSelector": "article, .article-content, .entry-content, main",
              "returnValue": "text"
            },
            {
              "key": "metaDescription",
              "cssSelector": "meta[name='description']",
              "returnValue": "attribute",
              "attribute": "content"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Extract Content",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [780, 740]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cleaned = items.map(item => {\n  const content = item.json.content || item.json.data || '';\n  // Remove extra whitespace and HTML remnants\n  const cleanedContent = content\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .substring(0, 5000);\n  \n  return {\n    json: {\n      title: item.json.title || '',\n      link: item.json.link || '',\n      content: cleanedContent,\n      pubDate: item.json.pubDate || new Date().toISOString(),\n      metaDescription: item.json.metaDescription || ''\n    }\n  };\n});\n\nreturn cleaned;"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "Clean Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 740]
    },
