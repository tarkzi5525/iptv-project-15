    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    improvedTitle: $input.first().json.output || $input.first().json.text || ''\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000012",
      "name": "improvedTitle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 860]
    },
    {
      "parameters": {
        "jsCode": "const schema = {\n  type: 'object',\n  properties: {\n    title: { type: 'string' },\n    seoScore: { type: 'number' },\n    suggestions: { type: 'array', items: { type: 'string' } }\n  }\n};\nreturn [{ json: { schema } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000013",
      "name": "Structured Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 860]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze and improve the meta description for this article:\n\nTitle: {{ $json.title }}\nCurrent Description: {{ $json.metaDescription }}\nContent Preview: {{ $json.content.substring(0, 500) }}\n\nProvide an improved SEO meta description (max 160 characters) that is compelling and includes relevant keywords.",
        "options": {
          "systemMessage": "You are an expert SEO specialist. Analyze meta descriptions and provide improved versions that are concise, compelling, and optimized for search engines."
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000020",
      "name": "Analyze Meta Description",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [360, 700]
