    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Perform a competitor analysis for this tech news article:\n\nTitle: {{ $json.title }}\nContent: {{ $json.content.substring(0, 1000) }}\nSource: {{ $json.link }}\n\nAnalyze:\n1. Main topic and category\n2. Target audience\n3. Content angle and unique value\n4. Potential competing articles/topics\n5. Recommendations to make the content more competitive",
        "options": {
          "systemMessage": "You are a content strategist and competitor analysis expert. Analyze articles and provide actionable competitive intelligence."
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000030",
      "name": "Competitor Analysis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 700]
    },
